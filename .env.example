# ==============================================================================
# VARIABLES DE ENTORNO - CENTRO DE PRODUCTIVIDAD ESTUDIANTIL
# ==============================================================================
# Copia este archivo como .env y completa tus valores reales.

# 1. Configuración de Supabase (Base de datos PostgreSQL, Auth & Storage)
# Obtén tus credenciales en: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Clave de API de Google Gemini (Deconstrucción de 7 Pilares e IA Multimodal)
# Obtén tu clave en Google AI Studio: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=AIzaSy...

# 3. Configuración del Servidor MCP (/api/mcp) en Vercel Serverless para Gemini Spark
# NOTA: Configura estas variables en Vercel -> Settings -> Environment Variables
SUPABASE_URL=https://your-project-id.supabase.co
# service_role key permite bypass de RLS a nivel de servidor (NUNCA exponer en frontend/Vite):
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Clave secreta para autorizar llamadas desde Gemini Spark (Header: Authorization: Bearer <TOKEN>):
MCP_SECRET_KEY=clave_secreta_super_segura_para_gemini_spark

